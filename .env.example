# Optional: AI explanations, paper summaries and report narratives.
# Everything else (data exploration, training, evaluation, reports) works without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local LLM (select "Ollama" in Settings, or set USE_OLLAMA=true)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
USE_OLLAMA=false

# Server
PORT=8000
MLAGENT_DATA_DIR=          # default: backend/var
MLAGENT_MAX_UPLOAD_MB=200
MLAGENT_MAX_JOBS=2         # concurrent training jobs
MLAGENT_CORS_ORIGINS=*     # comma-separated origins for split deployments

# Frontend (only when the API is on a different origin than the UI)
VITE_API_URL=
